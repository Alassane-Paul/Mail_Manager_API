# ── SERVER ──────────────────────────────────
PORT=4000
NODE_ENV=production

# ── DATABASE ─────────────────────────────────
# MySQL
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mail_manager
DB_USER=root
DB_PASS=votre_mot_de_passe

# ── JWT ──────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_key_in_production
JWT_EXPIRES_IN=12h
COOKIE_MAX_AGE=43200000

# ── MAILER (SMTP) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_application

# ── EMAIL SETTINGS ───────────────────────────
MAIL_FROM_NAME=Tutorat Tech
MAIL_FROM_ADDRESS=tutoratech@gmail.com
ADMIN_EMAIL=contact@tutoratech.com
API_URL=https://api.tutoratech.com

# ── CORS ─────────────────────────────────────
ALLOWED_ORIGINS=https://tutoratech.com,https://admin.tutoratech.com

# ── ADMIN (premier compte créé au démarrage) ──
ADMIN_EMAIL_DEFAULT=admin@tutoratech.com
ADMIN_PASSWORD_DEFAULT=ChangeThisAdminPassword!
